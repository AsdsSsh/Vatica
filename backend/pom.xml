<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>vatica</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>vatica</name>
	<description>Vatica - AI Office Agent Platform</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- 迭代 22D：模型、工具、MCP 全部由 AgentScope 原生实现。 -->
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-core</artifactId>
			<version>2.0.2</version>
		</dependency>
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-extensions-model-openai</artifactId>
			<version>2.0.2</version>
		</dependency>
		<!-- 迭代 22C：与 AgentScope 2.0.2 对齐的官方 MCP Java SDK；
		     同时承载 AgentScope MCP Client 与 Vatica Streamable HTTP Server。 -->
		<dependency>
			<groupId>io.modelcontextprotocol.sdk</groupId>
			<artifactId>mcp</artifactId>
			<version>0.17.0</version>
		</dependency>
		<!-- 迭代 22A：Anthropic 也使用 AgentScope 原生 Model 扩展，不再依赖 Spring AI 模型实现。 -->
		<dependency>
			<groupId>io.agentscope</groupId>
			<artifactId>agentscope-extensions-model-anthropic</artifactId>
			<version>2.0.2</version>
		</dependency>

		<!-- 迭代 9 I9-2：前后端分离——OpenAPI 契约（springdoc）。
		     3.1.0 面向 Spring Boot 4（模块化 starter 命名：spring-boot-tomcat / spring-boot-health）；
		     Swagger UI 开发期可视化契约，/v3/api-docs 为前后端唯一事实来源 -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!-- 迭代 19A：开发/云端主库切换 PostgreSQL；测试仍用 H2 保持单测零外部依赖 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- 迭代 19B：pgvector 适配器使用 JdbcTemplate 执行向量类型 SQL。 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- 旧 integrations.json 的 MYSQL 模式暂保兼容，默认配置已切 PostgreSQL。 -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<!-- 迭代 8 I8-1：runtime 而非 test——打包模式 packaged profile 用 H2 文件库
			     （零外部依赖开箱即用），测试继续用 H2 内存库 -->
			<scope>runtime</scope>
		</dependency>

		<!-- 迭代 3：Apache POI 文档生成（Word 周报 + Excel 统计）。
		     poi-ooxml 含 poi 核心；POI 5.5 默认绑定精简版 poi-ooxml-lite（仅含 POI 自身用到的 schema 子集），
		     本项目需直接操作 CT 层（设置中文字体 eastAsia），故排除 lite、改用完整 ooxml-schemas；
		     POI 5.x 走 Log4j2 API 记日志，log4j-to-slf4j（版本由 Boot 管理）把日志桥接到 SLF4J，避免 stderr 噪音 -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.5.1</version>
			<exclusions>
				<exclusion>
					<groupId>org.apache.poi</groupId>
					<artifactId>poi-ooxml-lite</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml-full</artifactId>
			<version>5.5.1</version>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-to-slf4j</artifactId>
		</dependency>

		<!-- 迭代 3.5：PIM 邮件工具。Angus Mail = Jakarta Mail（jakarta.mail API）+ 参考实现，
		     版本由 Boot 管理；GreenMail 内存 SMTP/IMAP 服务器做集成测试（真实协议收发，不 mock） -->
		<dependency>
			<groupId>org.eclipse.angus</groupId>
			<artifactId>jakarta.mail</artifactId>
		</dependency>
		<dependency>
			<groupId>com.icegreen</groupId>
			<artifactId>greenmail</artifactId>
			<version>2.1.12</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- AgentScope 源码保留独立目录以标清框架边界，但已属于默认生产构建。 -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<id>add-agentscope-source</id>
						<phase>generate-sources</phase>
						<goals><goal>add-source</goal></goals>
						<configuration>
							<sources><source>src/agentscope/java</source></sources>
						</configuration>
					</execution>
					<execution>
						<id>add-agentscope-test-source</id>
						<phase>generate-test-sources</phase>
						<goals><goal>add-test-source</goal></goals>
						<configuration>
							<sources><source>src/agentscope/test</source></sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.example.vatica.VaticaApplication</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
